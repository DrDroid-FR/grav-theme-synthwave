{% set hero_image = page.header.hero_image ? page.media[page.header.hero_image] : page.media.images|first %}

<section class="modular-hero" style="{% if hero_image %}background-image: url('{{ hero_image.url }}');{% endif %}">
    <div class="hero-city"></div>
    <div class="hero-sun"></div>
    <div class="hero-sky"></div>
    <div class="hero-grid"></div>
    {% if not theme_var('hide-play-button') %}
    <button class="play-btn" id="playBtn" aria-label="Play music">
        <svg viewBox="0 0 24 24" class="play-icon"><polygon points="5,3 19,12 5,21"/></svg>
        <svg viewBox="0 0 24 24" class="pause-icon"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
    </button>
    {% endif %}
    <div class="container">
        <h1>{{ page.title }}</h1>
        {% if page.header.description %}
        <p>{{ page.header.description }}</p>
        {% endif %}
        {% if page.content %}
        {{ page.content|raw }}
        {% endif %}
    </div>
</section>
