{% set columns = page.header.class == 'small' ? 'col-3 col-md-4 col-sm-6' : 'col-4 col-md-6 col-sm-12' %}

<section class="modular-features {{ page.header.class }}">
    <div class="container">
        <div class="features-grid">
            {{ page.content|raw }}
            <div class="columns">
            {% for feature in page.header.features %}
                <div class="feature-item">
                    {% if feature.url %}<a href="{{ feature.url }}">{% endif %}
                    {% if feature.icon %}
                    <div class="feature-icon">
                        <i class="fa fa-fw {{ feature.icon }}"></i>
                    </div>
                    {% endif %}
                    {% if feature.header %}
                    <h3>{{ feature.header }}</h3>
                    {% endif %}
                    {% if feature.text %}
                    <p>{{ feature.text }}</p>
                    {% endif %}
                    {% if feature.url %}</a>{% endif %}
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
</section>
