{% set data = page.header.gallery %}
{% set thumb_width = data.thumb.width|default(600) %}
{% set thumb_height = data.thumb.height|default(450) %}

<section class="modular-gallery">
    <div class="container">
        <div class="gallery-grid">
            {% for item in data.items %}
                {% set item_image = page.media[item.image] %}
                {% if item.title %}
                    {% set title = item.title %}
                {% endif %}
                <div class="gallery-item">
                    {{ item_image.cropZoom(thumb_width, thumb_height).html(title, title) }}
                    {% if item.desc %}
                    <p class="gallery-desc">{{ item.desc }}</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
