{% extends 'partials/base.html.twig' %}

{% block hero %}
<div class="hero">
    <div class="container">
        <h1>{{ page.title }}</h1>
        {% if page.header.subtitle %}
        <p>{{ page.header.subtitle }}</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block content %}
{{ page.content|raw }}
{% endblock %}