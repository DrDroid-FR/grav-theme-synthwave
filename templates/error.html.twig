{% extends 'partials/base.html.twig' %}

{% block hero %}
<div class="hero">
    <div class="container">
        <h1>{{ 'PLUGIN_ERROR.ERROR'|t }} {{ page.header.http_response_code }}</h1>
        {% if page.header.subtitle %}
        <p>{{ page.header.subtitle }}</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block content %}
<div class="content">
    <div class="container">
        <p>{{ page.content|raw }}</p>
    </div>
</div>
{% endblock %}
